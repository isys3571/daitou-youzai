{# ══ PAGE HEADER (太罫 + 細罫) ═══════════════════════ #}
<section class="border-t-[3px] border-primary">
  <div class="border-t border-primary"></div>
  <div class="container pt-10 md:pt-14 pb-10 md:pb-14">
    <h1 class="font-display font-semibold text-primary leading-[1.15] text-[28px] md:text-[36px] tracking-[0.02em]">
      取扱商品
    </h1>
    <div class="mt-6 text-body text-[15px] leading-[2] space-y-1">
      <p>高圧ガス・溶接機材・工作機械などを中心に、製造現場に必要な商材を幅広く取り扱っています。</p>
      <p>商品のお問い合わせはお気軽にご連絡ください。</p>
    </div>
  </div>
</section>

{# ══ MAIN: SIDEBAR (問い合わせ + 所在地) + CATEGORIES ═ #}
<section class="border-t border-primary">
  <div class="container">
    <div class="grid grid-cols-12 gap-0">

      {# ─── SIDEBAR ─── #}
      <aside class="col-span-12 md:col-span-3 md:border-r md:border-gray-200 md:pr-8 py-10">
        <div class="md:sticky md:top-6 space-y-10">

          {# お問い合わせ #}
          <div class="border-t-[2px] border-primary pt-6">
            <div class="font-display font-semibold text-primary text-[15px] leading-[1.75]">
              お問い合わせ
            </div>
            <p class="mt-2 text-body text-[13px] leading-[1.9]">
              型番・数量・希望納期を<br>お知らせください
            </p>

            <dl class="mt-5">
              <div>
                <dt class="font-sans text-[11px] tracking-[0.1em] text-muted">電話</dt>
                <dd>
                  <a href="tel:{{ site.tel }}"
                     class="font-en font-medium text-primary text-[22px] leading-tight block mt-1 hover:text-accent transition-colors">
                    {{ site.tel }}
                  </a>
                </dd>
              </div>
              <div class="mt-3 pt-3 border-t border-gray-200">
                <dt class="font-sans text-[11px] tracking-[0.1em] text-muted">FAX</dt>
                <dd class="mt-1 font-en font-medium text-primary text-[16px]">{{ site.fax }}</dd>
              </div>
              <div class="mt-3 pt-3 border-t border-gray-200">
                <dt class="font-sans text-[11px] tracking-[0.1em] text-muted">受付</dt>
                <dd class="mt-1 text-body text-[12.5px]">平日 8:30–17:30</dd>
              </div>
            </dl>

            <a href="/contact/"
               class="mt-6 group flex items-center justify-between gap-3 border border-primary text-primary px-4 py-3 hover:bg-primary hover:text-white transition-colors">
              <span class="font-sans text-[13px] font-medium">フォームで問い合わせる</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/>
              </svg>
            </a>
          </div>

          {# 所在地 #}
          <div class="border-t-[2px] border-primary pt-6">
            <div class="font-display font-semibold text-primary text-[15px] leading-[1.75]">
              所在地
            </div>
            <address class="mt-3 text-body text-[13px] leading-[1.9] not-italic">
              {{ site.address | replace(' ', '<br>') | safe }}
            </address>

            <div class="mt-4 pt-4 border-t border-gray-200">
              <dt class="font-sans text-[11px] tracking-[0.1em] text-muted">最寄駅</dt>
              <dd class="mt-1 text-body text-[12.5px] leading-[1.85]">
                長田駅<br>
                <span class="text-muted">大阪メトロ中央線 / 近鉄けいはんな線<br>2番出口より徒歩約6分</span>
              </dd>
            </div>

            <a href="/access/"
               class="mt-5 group inline-flex items-center gap-2 text-primary text-[12.5px] font-medium hover:text-accent transition-colors">
              <span>アクセス・地図を見る</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/>
              </svg>
            </a>
          </div>

        </div>
      </aside>

      {# ─── CONTENT ─── #}
      <div class="col-span-12 md:col-span-9 md:pl-8 py-10">

        <h2 class="font-display font-semibold text-primary text-[22px] md:text-[24px] mb-8 pb-3 border-b-[2px] border-primary">
          取扱品目一覧
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2">
          {% for it in items %}
          <article id="c-{{ it.no }}"
            class="py-7 border-b border-gray-200 md:px-6
                   {% if loop.index0 % 2 == 1 %}md:border-l md:border-gray-200{% endif %}
                   {% if loop.last and (items | length) % 2 == 1 %}md:col-span-2{% endif %}">
            <div class="flex items-start gap-5">
              <div class="pt-1 shrink-0">
                <div class="font-en font-medium text-primary text-[34px] leading-none tracking-[-0.01em]">{{ it.no }}</div>
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="font-display font-semibold text-primary text-[20px] leading-tight mb-4">{{ it.ja }}</h3>
                <div class="text-body text-[13.5px] leading-[1.95]">
                  {% for line in it.body %}
                  <p{% if not loop.first %} class="mt-1"{% endif %}>{{ line }}</p>
                  {% endfor %}
                </div>
              </div>
            </div>
          </article>
          {% endfor %}
        </div>

        {# 備考 #}
        <aside class="mt-10 border-t-[2px] border-primary pt-5 pb-2 flex flex-col md:flex-row md:items-baseline gap-3">
          <span class="font-sans font-medium text-[12px] tracking-[0.1em] text-muted md:w-20 shrink-0">※ 備考</span>
          <p class="text-body text-[13px] leading-[2]">
            上記は主な取扱カテゴリです。掲載のない商品についてもお取り寄せ可能な場合がございますので、お気軽にお問い合わせください。
          </p>
        </aside>

      </div>
    </div>
  </div>
</section>

